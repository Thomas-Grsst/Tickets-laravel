<?php

// Hand-maintained copy of the mixin xefi/faker-php generates into faker_mixin.php on every
// `composer install` (that file is gitignored, so it isn't available on a fresh clone or in
// CI). This copy additionally specifies array value types where the generated one leaves
// them bare, since PHPStan's level 6 flags iterable types without one.

namespace Xefi\Faker\Container {
    /**
     * @method array<int, string> wordsAsArray(int $words = 3)
     * @method string words(int $words = 3)
     * @method array<int, string> sentencesAsArray(int $sentences = 3)
     * @method string sentences(int $sentences = 3)
     * @method array<int, string> paragraphsAsArray(int $paragraphs = 3)
     * @method string paragraphs(int $paragraphs = 3)
     * @method ?string getLocale()
     * @method int digit()
     * @method int number(int $min, int $max)
     * @method float float(float $min, float $max, int $decimals = 1)
     * @method mixed letter()
     * @method array<int|string, mixed>|string shuffle(array<int|string, mixed>|string $needle)
     * @method string shuffleString(string $needle)
     * @method array<int|string, mixed> shuffleArray(array<int|string, mixed> $needle)
     * @method string convertCharacters(string $string)
     * @method string semver()
     * @method string emoji()
     * @method string uuid()
     * @method string ulid()
